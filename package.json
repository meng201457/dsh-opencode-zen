{
  "name": "dsh-opencode-zen",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "description": "OpenCode Zen/Go client-identity headers for DSH, injected at the fetch layer with its configuration form on the Plugins page.",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs && node test/mount.mjs && node test/loader-contract.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
